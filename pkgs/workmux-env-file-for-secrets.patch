+
+    #[test]
+    fn test_write_env_file() {
+        let dir = tempfile::tempdir().unwrap();
+        let assignments = vec![
+            "WM_RPC_TOKEN='abc'".to_string(),
+            format!("TOKEN='{}'", crate::shell::shell_escape("it's $HOME")),
+        ];
+        let file = write_env_file(dir.path(), &assignments).unwrap();
+        let path = file.path().to_path_buf();
+
+        assert_eq!(
+            std::fs::read_to_string(&path).unwrap(),
+            "export WM_RPC_TOKEN='abc'\nexport TOKEN='it'\\''s $HOME'\n"
+        );
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            let mode = std::fs::metadata(&path).unwrap().permissions().mode();
+            assert_eq!(mode & 0o777, 0o600);
+        }
+
+        let output = Command::new("sh")
+            .arg("-c")
+            .arg(r#". "$1" && printf '%s' "$TOKEN""#)
+            .arg("sh")
+            .arg(&path)
+            .output()
+            .unwrap();
+        assert_eq!(String::from_utf8_lossy(&output.stdout), "it's $HOME");
+
+        drop(file);
+        assert!(!path.exists());
+    }
 }
