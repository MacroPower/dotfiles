+/// Write one `export` line per assignment to a new file in `dir`.
+///
+/// The file is readable only by its owner and has a random name. Dropping the
+/// returned handle deletes it.
+fn write_env_file(dir: &Path, assignments: &[String]) -> Result<tempfile::NamedTempFile> {
+    use std::io::Write;
+
+    let mut file = tempfile::Builder::new()
+        .prefix(".env-")
+        .tempfile_in(dir)
+        .context("Failed to create sandbox env file")?;
+    for assignment in assignments {
+        writeln!(file, "export {assignment}").context("Failed to write sandbox env file")?;
+    }
+    file.flush().context("Failed to write sandbox env file")?;
+    Ok(file)
+}
