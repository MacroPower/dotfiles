+/*
+ * On some shared filesystems, such as virtiofs, open() fails with
+ * ENOENT while another process renames a new index over the path,
+ * although lstat() still finds the file. A caller that takes that
+ * ENOENT for a missing index reads an empty index, and a later write
+ * records it. Retry for up to 3 seconds while lstat() finds the file.
+ */
+static int open_index(const char *path)
+{
+	struct stat st;
+	int tries;
+
+	for (tries = 0; ; tries++) {
+		int fd = open(path, O_RDONLY);
+
+		if (fd >= 0 || errno != ENOENT)
+			return fd;
+		if (tries >= 300 || lstat(path, &st)) {
+			errno = ENOENT;
+			return -1;
+		}
+		sleep_millisec(10);
+	}
+}
+
