diff --git a/harper-core/src/spell/precomputed.rs b/harper-core/src/spell/precomputed.rs
new file mode 100644
index 0000000..75038e0
--- /dev/null
+++ b/harper-core/src/spell/precomputed.rs
@@ -0,0 +1,176 @@
+//! The curated dictionary in a precomputed binary form.
+//!
+//! Building the curated dictionary from its rune files expands every affix
+//! and compiles an FST and a trie over the result, which takes most of
+//! Harper's startup time. [`encode`] returns the finished structures, and
+//! `harper-cli dump-curated-dictionary` writes them to a file. A build with
+//! `HARPER_PRECOMPUTED_DICT` set to that file embeds it, and the curated
+//! dictionaries load from it instead of building.
+//!
+//! The encoding holds a hash of the rune files that produced it. When the
+//! hash does not match the rune files of this build, or the bytes fail to
+//! decode, the curated dictionaries build from the rune files.
+
+use std::hash::BuildHasher;
+use std::sync::{Arc, Mutex};
+
+use foldhash::fast::FixedState;
+use serde::{Deserialize, Serialize};
+use trie_rs::Trie;
+
+use super::mutable_dictionary::{CURATED_ATTRIBUTES, CURATED_WORDS, build_curated};
+use super::{FstDictionary, MutableDictionary, TrieDictionary};
+
+#[derive(Serialize)]
+struct EncodedRef<'a> {
+    source_hash: u64,
+    mutable: &'a MutableDictionary,
+    fst: &'a [u8],
+    trie: &'a Trie<char>,
+}
+
+#[derive(Deserialize)]
+struct Encoded {
+    source_hash: u64,
+    mutable: MutableDictionary,
+    fst: Vec<u8>,
+    trie: Trie<char>,
+}
+
+/// The decoded curated dictionary. The FST and the trie each belong to one
+/// curated dictionary, so each one moves out on its first use.
+pub(super) struct Precomputed {
+    pub mutable: Arc<MutableDictionary>,
+    fst: Mutex<Option<Vec<u8>>>,
+    trie: Mutex<Option<Trie<char>>>,
+}
+
+impl Precomputed {
+    pub fn take_fst(&self) -> FstDictionary {
+        let bytes = self
+            .fst
+            .lock()
+            .unwrap()
+            .take()
+            .expect("The precomputed FST was already taken.");
+        FstDictionary::from_parts(self.mutable.clone(), bytes)
+    }
+
+    pub fn take_trie(&self) -> Trie<char> {
+        self.trie
+            .lock()
+            .unwrap()
+            .take()
+            .expect("The precomputed trie was already taken.")
+    }
+}
+
+fn config() -> impl bincode::config::Config {
+    bincode::config::standard()
+}
+
+fn source_hash() -> u64 {
+    FixedState::default().hash_one((CURATED_WORDS, CURATED_ATTRIBUTES))
+}
+
+/// Builds the curated dictionary from its rune files and encodes it for a
+/// build with `HARPER_PRECOMPUTED_DICT`.
+pub fn encode() -> Vec<u8> {
+    let mutable = build_curated();
+    let fst: Arc<FstDictionary> = Arc::new((*mutable).clone().into());
+    let trie = TrieDictionary::new(fst.clone());
+
+    // The FST dictionary rebuilds its own word list from the curated one.
+    // The decoded dictionaries share one list, which holds only when the
+    // two match.
+    assert!(
+        **fst.mutable_dict() == *mutable,
+        "The FST dictionary's word list differs from the curated one."
+    );
+
+    bincode::serde::encode_to_vec(
+        EncodedRef {
+            source_hash: source_hash(),
+            mutable: &mutable,
+            fst: fst.fst_bytes(),
+            trie: trie.trie(),
+        },
+        config(),
+    )
+    .expect("Unable to encode the curated dictionary.")
+}
+
+#[cfg_attr(not(harper_precomputed_dict), allow(dead_code))]
+fn decode(bytes: &[u8]) -> Option<Precomputed> {
+    let (encoded, _): (Encoded, usize) =
+        bincode::serde::decode_from_slice(bytes, config()).ok()?;
+    if encoded.source_hash != source_hash() {
+        return None;
+    }
+    Some(Precomputed {
+        mutable: Arc::new(encoded.mutable),
+        fst: Mutex::new(Some(encoded.fst)),
+        trie: Mutex::new(Some(encoded.trie)),
+    })
+}
+
+#[cfg(harper_precomputed_dict)]
+static PRECOMPUTED: std::sync::LazyLock<Option<Precomputed>> = std::sync::LazyLock::new(|| {
+    decode(include_bytes!(env!("HARPER_PRECOMPUTED_DICT")))
+});
+
+/// The embedded curated dictionary, when this build has one that matches
+/// its rune files.
+pub(super) fn get() -> Option<&'static Precomputed> {
+    #[cfg(harper_precomputed_dict)]
+    {
+        PRECOMPUTED.as_ref()
+    }
+    #[cfg(not(harper_precomputed_dict))]
+    {
+        None
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::spell::Dictionary;
+
+    #[test]
+    fn round_trips() {
+        let decoded = decode(&encode()).expect("The encoding should decode.");
+        let built = build_curated();
+        assert_eq!(*decoded.mutable, *built);
+
+        let fst = decoded.take_fst();
+        let expected: FstDictionary = (*built).clone().into();
+        assert_eq!(fst.fst_bytes(), expected.fst_bytes());
+
+        let trie = decoded.take_trie();
+        let expected = TrieDictionary::new(Arc::new(expected));
+        assert!(
+            trie.iter::<String, _>()
+                .eq(expected.trie().iter::<String, _>())
+        );
+        assert!(fst.contains_word_str("this"));
+    }
+
+    #[test]
+    fn rejects_other_sources() {
+        let mutable = MutableDictionary::new();
+        let fst: Arc<FstDictionary> = Arc::new(mutable.clone().into());
+        let trie = TrieDictionary::new(fst.clone());
+        let bytes = bincode::serde::encode_to_vec(
+            EncodedRef {
+                source_hash: source_hash().wrapping_add(1),
+                mutable: &mutable,
+                fst: fst.fst_bytes(),
+                trie: trie.trie(),
+            },
+            config(),
+        )
+        .unwrap();
+        assert!(decode(&bytes).is_none());
+    }
+}
