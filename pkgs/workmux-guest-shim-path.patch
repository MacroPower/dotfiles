+    #[test]
+    fn test_guest_path_export_names_shim_mount() {
+        // The mount point lies outside $HOME, and its path needs quoting.
+        let shim_bin = Path::new("/home/o'brien $USER.guest/.workmux-state/shims/bin");
+        let output = Command::new("sh")
+            .arg("-c")
+            .arg(format!(
+                r#"export {}; printf '%s' "$PATH""#,
+                guest_path_export(shim_bin)
+            ))
+            .env("HOME", "/home/obrien")
+            .output()
+            .unwrap();
+        let inherited = std::env::var("PATH").unwrap_or_default();
+        assert_eq!(
+            String::from_utf8_lossy(&output.stdout),
