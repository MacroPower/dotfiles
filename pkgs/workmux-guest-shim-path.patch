+/// Build the `PATH` assignment that the guest shell exports before it runs the
+/// agent command. The assignment puts `shim_bin` ahead of every other directory.
+///
+/// `shim_bin` is the guest path of the shim directory, under the mount point of
+/// the state directory. A guest image can give its user a `$HOME` other than
+/// the Lima guest home that holds that mount point. So the assignment names
+/// `shim_bin` itself and not a path under `$HOME`.
+fn guest_path_export(shim_bin: &Path) -> String {
+    format!(
+        r#"PATH={}:"$HOME/.local/bin:/nix/var/nix/profiles/default/bin:$PATH""#,
+        crate::shell::shell_quote(&shim_bin.to_string_lossy())
+    )
+}
