+
 pub fn split(
     commit: &str,
     pick_groups: &[crate::PickGroup],
     rest_message: Option<&[String]>,
+) -> Result<()> {
+    let mut restore = SplitRestore::default();
+    let result = split_inner(commit, pick_groups, rest_message, &mut restore);
+    if result.is_err() && restore.armed {
+        restore_failed_split(&restore);
+    }
+    result
+}
+
+/// Put HEAD, the index, and the working tree back to their state before a
+/// failed split. Split requires a clean working tree and only ever leaves the
+/// target commit's content in it, so a hard reset to the target loses nothing.
+fn restore_failed_split(restore: &SplitRestore) {
+    let run = |args: &[&str]| {
+        Command::new("git")
+            .args(args)
+            .output()
+            .map(|o| o.status.success())
+            .unwrap_or(false)
+    };
+
+    let mut ok = run(&["reset", "--hard", &restore.target_sha]);
+    if restore.in_rebase && rebase_in_progress() {
+        ok &= run(&["rebase", "--abort"]);
+    }
+    let head = crate::diff::run_git_cmd(Command::new("git").args(["rev-parse", "HEAD"]))
+        .map(|s| s.trim().to_string())
+        .unwrap_or_default();
+
+    if ok && head == restore.orig_head {
+        eprintln!("split failed; restored the repository to its previous state");
+    } else {
+        eprintln!("error: split failed and the repository could not be restored");
+        eprintln!("to restore it manually, run:");
+        if restore.in_rebase {
+            eprintln!("  git rebase --abort");
+        }
+        eprintln!("  git reset --hard {}", restore.orig_head);
+    }
+}
