# The Recommended rule of the same name holds every other puff word.
# `genuinely` sits here, because it sometimes separates a real case
# from an apparent one (`a line is added only when the file genuinely
# ends in a blank line`). The adjective `genuine` stays out, since it
# usually means authentic (`the badge in the footer is genuine`).
expr main genuinely
let message "Puff. State the fact and let the reader judge its weight."
let description "Flags genuinely, which usually inflates a claim without informing."
let becomes ""
let kind "Style"
allows "The badge in the footer is genuine."
allows "The path is contended under load."
