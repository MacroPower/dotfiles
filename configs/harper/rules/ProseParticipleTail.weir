# A curated list, because `, PROG` fires on `, including`, `, using`,
# and `, according`. Words that double as nouns or conjunctions carry
# the word that marks the tail sense: `leading to`, `resulting in`,
# `meaning that` or `meaning the`, and `providing` without `that`. The
# trailing `![,, and, or]` skips a gerund that is one item in a list
# (`allowing, enabling, and letting`) or a pair (`keeping and
# dropping`); with Weir's whitespace tokens, a comma glued to the word
# fails the match on its own.
#
# Two shapes stay flagged on purpose, since a word rule cannot tell
# them from a tail and both rewrite cleanly: a gerund subject after a
# fronted clause (`If the file is missing, creating it is the caller's
# job`) and a participle phrase bracketed by commas (`The scheduler,
# allowing for clock skew, waits five seconds`).
expr plain [ensuring, allowing, enabling, making, highlighting, fostering, giving, helping, improving, reducing, increasing, causing, creating, showing, demonstrating, indicating, keeping, letting, preventing, avoiding, streamlining, simplifying]
expr main , [(@plain ![,, and, or]), (leading to), (resulting in), (meaning [that, the, a, an, it, you, we, they]), (providing ![that, and, or])]
let message "Participle tacked on after a comma. Give the point its own sentence."
let description "Flags a comma followed by a participle that adds a consequence to the clause before it."
let becomes ""
let kind "Style"
let scope "Sentence"
allows "The flags, including --foo, are optional."
allows "The job runs nightly, using the cached index."
allows "The words allowing, enabling, and letting are near synonyms."
allows "The two options, keeping and dropping, are mutually exclusive."
allows "Strip trailing spaces, leading whitespace, and blank lines."
allows "Each key has a type, meaning, and default."
allows "Without a cache, resulting builds take twice as long."
allows "The job retries, providing that the budget allows it."
allows "The struct has two callbacks, providing and consuming."
