# A space in a Weir pattern matches a whitespace token, so the label
# exception sits directly against the colon: `image:` tokenizes as
# `image` and `:` with no whitespace between them.
#
# Harper's tagger misses many third-person verbs after a noun phrase
# (`refills`, `misses`, `trips`), so the determiner branch also
# accepts an auxiliary or one of the adverbs that precede a verb in a
# clause. `most` and `very` are left out because they open noun
# phrases (`Default: the most recent tag`).
expr adverbs [never, always, also, only, silently, still, then, already, just, now, usually, often, sometimes, rarely, immediately, eventually]
expr labels [Note, Warning, Tip, Caution, Important, Deprecated, TODO, FIXME, BUG, HACK, XXX]
expr main !@labels: [([it, they, we, you, I, there, he, she] *), ([DET, PRON] [VERB, AUX, @adverbs, (* [VERB, AUX, @adverbs]), (* * [VERB, AUX, @adverbs])])]
let message "Colon between two clauses. End the sentence with a period, or join the clauses with because or so."
let description "Flags a colon followed by a subject pronoun, or by a determiner and a verb within three words."
let becomes ""
let kind "Punctuation"
let scope "Sentence"
allows "Note: the cache is cold on first run."
allows "Tip: you can skip the check."
allows "Run this command: make test"
allows "The options are: fast, slow, and medium."
allows "Default: the most recent tag."
allows "Deprecated: this method returns nil."
allows "TODO: it needs a lock."
