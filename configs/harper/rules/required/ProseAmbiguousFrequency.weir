# `biweekly` means both twice a week and every two weeks, and
# `bimonthly`, `biannual`, and `biyearly` split the same way, so the
# reader has to guess the interval. The fix states it (`every two
# weeks`). A space in a pattern matches only whitespace, so the
# `bi-` branch matches the hyphenated spelling.
#
# It hit 3 lines in the measure.py corpus, and all 3 left the interval
# to the reader (`the bi-weekly SIG meetings`).
expr main [biweekly, bimonthly, biannual, biannually, biyearly, (bi-[weekly, monthly, annual, annually, yearly])]
let message "Ambiguous frequency. Write the interval, such as `twice a week` or `every two weeks`."
let description "Flags `biweekly`, `bimonthly`, `biannual`, and `biyearly`, which each name two intervals."
let becomes ""
let kind "Style"
allows "The report runs every two weeks."
allows "The binary runs weekly."
