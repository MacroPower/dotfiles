# Harper reads `--` as two hyphen tokens, so the double dash has two
# forms: two hyphens before whitespace (`nightly -- the`, and the
# last two of `---`), and two hyphens glued to the word before them
# (`nightly--the`). A hyphen pair after whitespace and glued to the
# word after it is a long flag (`--commit`) and passes. A bare `--`
# separator in prose fires, and the fix sets it in a code span.
#
# A single hyphen with whitespace and a word on both sides stands in
# for a dash too (`excluded on purpose - the`), because a writer barred
# from the em dash reaches for it next. Glued hyphens pass
# (`well-known`, `1-5`, `-1`), and so do list markers, which have no
# word before them.
expr word [NOUN, VERB, ADJ, ADV, PRON, DET, PROPN, NUM]
expr main [—, –, (-- ), (@word--), (@word - @word)]
let message "Dash. Use a period, a comma, or a conjunction."
let description "Flags every em dash and en dash, and a double or spaced hyphen used as one."
let becomes ""
let kind "Punctuation"
allows "The job runs nightly, and the cache refills."
allows "The flag is --commit."
allows "Run prose-lint --commit on the message."
allows "A well-known bug hides here."
allows "The range 1-5 is closed."
allows "The -1 value means unset."
allows "Pass -v to print each step."
allows "The window holds `n - 1` entries."
