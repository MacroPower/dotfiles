# Each phrase announces a point instead of making it (`keep in mind
# that the walk never revisits a node` becomes `the walk never
# revisits a node`). Four rules hold the narrower shapes: the
# back-reference rule (`as mentioned above`), the sentence-adverb rule
# (`Clearly,`), the restatement rule (`in other words,`), and the pivot
# rule (`that said,`).
#
# `note that` sits in the Recommended rule of the same name, because a
# commit subject uses `note` as a verb (`docs: note that the flag is
# sticky`).
expr main [(worth noting), (it should be noted), (it must be noted), (please note), (keep in mind), (bear in mind), (it is important to [note, remember, understand, mention, realize, recognize]), (it's important to [note, remember, understand, mention, realize, recognize]), (needless to say), (as you can see), (of course), (make no mistake), (it goes without saying), (at the end of the day), (as a matter of fact), (worth mentioning)]
let message "Throat clearing. Delete the phrase and state the point."
let description "Flags phrases that announce a point instead of making it."
let becomes ""
let kind "Style"
let scope "Sentence"
allows "The note field holds free text."
allows "The lookup is not an offset into the token list."
