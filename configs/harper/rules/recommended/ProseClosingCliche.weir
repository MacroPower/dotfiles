# Each line ends a section without saying anything, so the fix ends
# the section on its last fact.
expr main [(the future looks bright), (only time will tell), (exciting times ahead), (the possibilities are endless), (that's it), (you're all set), (you are all set), (say goodbye to)]
let message "Closing cliche. Delete it and end on the last fact."
let description "Flags cliches that end a section without saying anything."
let becomes ""
let kind "Style"
allows "The event log records every retry."
