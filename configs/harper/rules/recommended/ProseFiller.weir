# The Required rule of the same name holds every other announcement.
# `note that` sits here, because a commit subject uses `note` as a verb
# (`docs: note that the flag is sticky`), and no pattern tells that
# verb from the filler that opens `Note that the cache is cold`.
# `notice that` and `remember that` sit here too, because a sentence
# can describe a reader or a program doing either (`you might notice
# that the pods restart`, `the cache must remember that the key
# expired`).
expr main [(note that), (notice that), (remember that)]
let message "Filler phrase. Delete the phrase and state the point."
let description "Flags note that, notice that, and remember that, which announce a point instead of making it."
let becomes ""
let kind "Style"
allows "The note field holds free text."
allows "Each note has a title and a body."
