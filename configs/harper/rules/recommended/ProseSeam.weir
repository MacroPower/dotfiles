# `seam` borrows the legacy-code term for a place where behavior can be
# swapped without an edit, and it rarely says which place. When the
# sentence means one, it names the function, interface, or hook (`the
# injection seam` becomes `the Now field that tests replace`). When it
# means none, the word goes.
#
# The literal sense passes before a construction word (`seam tape`, `a
# standing seam roof`) and before a slash (`seam/flashing checks`), the
# shape a roofing scope list takes. The guard sits glued to the word so
# it reads the token right after it, which also lets a word at the end
# of a line count.
expr literal [flashing, tape, tapes, sealer, sealant, roof, roofs, roofing, weld, welds, welded, metal, allowance, ripper]
expr main [seam, seams]![(( )@literal), /]
let message "Seam. Name the function, interface, or hook it means, or delete the word."
let description "Flags seam as a metaphor for a point where code joins or swaps behavior."
let becomes ""
let kind "Style"
let scope "Sentence"
allows "Apply seam tape before the second coat."
allows "The crew quoted a standing seam metal roof."
allows "The visit covers seam/flashing/penetration checks."
allows "The Now field lets a test replace the clock."
