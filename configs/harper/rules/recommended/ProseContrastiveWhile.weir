# `while` marks time (`while the lock is held`), so a reader who meets
# it after a comma has to decide whether it marks a contrast instead
# (`reads are fast, while writes are slow`). `while` with no comma
# before it passes. A `while` after a comma that marks time (`It is
# served anyway, while the refresher catches up`) reads one way after
# the comma goes.
#
# It hit 50 lines in the measure.py corpus, and 20 of 20 sampled hits
# marked a contrast.
expr main , (while [DET, PRON, PROPN])
let message "Contrastive while. Write but for a contrast, or split the sentence."
let description "Flags while after a comma, where it usually marks a contrast that but marks in one reading."
let becomes ""
let kind "Style"
let scope "Sentence"
allows "The hook waits while the lock is held."
